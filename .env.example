# Docker Compose settings. Replace every default before production use.
POSTGRES_USER=blog_user
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=blog_db

# Public frontend origins accepted by the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Use .your-domain.com when www and blog are sibling production subdomains.
SESSION_COOKIE_DOMAIN=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
READER_SESSION_DAYS=30
GOOGLE_CLIENT_ID=
MEDIA_STORAGE=local
MEDIA_PUBLIC_URL=http://localhost:4001/media
IMAGE_HOSTS=images.unsplash.com
BLOG_SITE_URL=http://localhost:3001
